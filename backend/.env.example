APP_NAME=enagalar.uz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uz_UZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal ishlash uchun sqlite yetarli; docker-compose bilan: DB_CONNECTION=pgsql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=enagalar
# DB_USERNAME=enagalar
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime chat (Laravel Reverb). Lokal ishga tushirish: php artisan reverb:start
# Navbat ishchisi ham kerak: php artisan queue:work (hodisalar va Telegram bildirishnomalari navbat orqali)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=enagalar
REVERB_APP_KEY=enagalar-local-key
REVERB_APP_SECRET=enagalar-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=enagalaruz_bot
TELEGRAM_WEBHOOK_SECRET=

# AI moslashtirish (Claude). Kalit bo'lmasa yoki o'chirilsa, qoidalarga asoslangan hisob ishlaydi.
ANTHROPIC_API_KEY=
ANTHROPIC_MATCHING_MODEL=claude-haiku-5-5
AI_MATCHING_ENABLED=true
AI_DAILY_LIMIT=30

# Productionda: enagalar.uz,www.enagalar.uz
REVERB_ALLOWED_ORIGINS=*

# Bonus tizimi (so'm, naqd emas)
BONUS_EXPIRY_MONTHS=9
BONUS_SURVEY=50000
BONUS_LISTING=30000
BONUS_REFERRAL=15000
BONUS_REFERRAL_MAX=5
BONUS_LIFETIME_CAP=200000
BONUS_SURVEY_MIN_SECONDS=60
BONUS_SURVEY_FLAG_SECONDS=240
