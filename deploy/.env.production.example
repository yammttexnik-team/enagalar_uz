# enagalar.uz production. Nusxa: cp .env.production.example .env.production && chmod 600 .env.production
# Bu fayl git'ga qo'shilmaydi. Haqiqiy parollarni faqat serverda yozing.
# Parol yaratish: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# ---------- Domen / Caddy ----------
APP_DOMAIN=enagalar.uz
ACME_EMAIL=admin@enagalar.uz           # Let's Encrypt xabarnomalari uchun

# ---------- Laravel ----------
APP_NAME=enagalar.uz
APP_ENV=production
APP_DEBUG=false
# Yaratish: docker compose --env-file .env.production -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_URL=https://enagalar.uz
FRONTEND_URL=https://enagalar.uz
APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ---------- PostgreSQL ----------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=enagalar
DB_USERNAME=enagalar
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---------- Redis (cache, queue, session) ----------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.enagalar.uz

# ---------- Fayllar ----------
# 'local' = storage/app/private. 'private' disk (pasport) va 'public' disk kodda alohida; hammasi "storage" volume'da.
FILESYSTEM_DISK=local

# ---------- Sanctum / CORS (frontend va API bitta domenda, shuning uchun bir xil) ----------
SANCTUM_STATEFUL_DOMAINS=enagalar.uz,www.enagalar.uz

# ---------- Reverb (websocket) ----------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=enagalar
REVERB_APP_KEY=CHANGE_ME_REVERB_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
# Laravel -> Reverb (ichki tarmoq, Docker ichida)
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Brauzer -> Reverb (Caddy orqali wss://enagalar.uz/app/...)
NUXT_PUBLIC_REVERB_HOST=enagalar.uz
NUXT_PUBLIC_REVERB_PORT=443
NUXT_PUBLIC_REVERB_SCHEME=https

# ---------- Nuxt (frontend) ----------
NUXT_PUBLIC_API_BASE=https://enagalar.uz/api/v1
NUXT_PUBLIC_SITE_URL=https://enagalar.uz

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=enagalar_bot
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ---------- AI (Claude) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MATCHING_MODEL=claude-haiku-5-5
AI_MATCHING_ENABLED=true
AI_DAILY_LIMIT=30

# ---------- Pochta ----------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@enagalar.uz
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Backup (backup.sh o'qiydi, ixtiyoriy) ----------
BACKUP_DIR=/home/deploy/backups
BACKUP_KEEP_DAYS=14
# rclone remote (masalan: eu-s3:enagalar-backups). FAQAT EI/EU serveri (ZRU-1125). Bo'sh bo'lsa faqat lokal.
RCLONE_REMOTE=

# Websocket ulanishiga ruxsat berilgan domenlar
REVERB_ALLOWED_ORIGINS=enagalar.uz,www.enagalar.uz
